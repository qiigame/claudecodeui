# Shared developer/analysis service: replace placeholders in private config.
# Do not copy another deployment's identities, allowlists, keys or database.
CLOUDCLI_DEPLOYMENT_PROFILE=developer
CLOUDCLI_DEFAULT_PERMISSION_MODE=bypassPermissions
CLOUDCLI_REQUIRE_DINGTALK_AUTH=true
CLOUDCLI_IDENTITY_REGISTRY_REQUIRED=1
# Change only through this deployment's explicit tool-startup approval.
CLOUDCLI_IDENTITY_STARTUP_APPROVED=0
CLOUDCLI_DINGTALK_CREDENTIALS_FILE=/run/secrets/cloudcli-dingtalk.json
CLOUDCLI_DINGTALK_PUBLIC_ORIGIN=https://analysis-cloudcli.example.invalid
CLOUDCLI_IDENTITY_REGISTRY_PATH=/run/config/identities.json
CLOUDCLI_IDENTITY_RUNTIME_MAP_PATH=/run/secrets/identity-runtime-map.json

VITE_IS_PLATFORM=false
VITE_COMIC_RUNTIME_ONLY=true
DATABASE_PATH=/srv/cloudcli/state/auth.db

# Current setting used by both the runtime bridge and model catalog.
COMIC_CC_SWITCH_SYNC=1
# Preserve existing service-account state unless isolation is being migrated.
# COMIC_CC_SWITCH_CODEX_CONFIG_PATH=/srv/cloudcli/credentials/codex/config.toml
# COMIC_CC_SWITCH_CLAUDE_SETTINGS_PATH=/srv/cloudcli/credentials/claude/settings.json
# If the provider uses an isolated CODEX_HOME, point the helper at the original
# credential source rather than copying auth.json into the source checkout.
# COMIC_DATAVERSE_TOKEN_HELPER=/srv/cloudcli/bin/dataverse-token-helper
# COMIC_DATAVERSE_TOKEN_HELPER_CODEX_HOME=/srv/cloudcli/credentials/codex
