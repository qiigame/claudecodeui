# Product/QA service: copy to private deployment configuration and replace paths.
# Preserve the service's existing allowlists, verified identities and state.
CLOUDCLI_DEPLOYMENT_PROFILE=product-qa-readonly
CLOUDCLI_DEFAULT_PERMISSION_MODE=default
CLOUDCLI_REQUIRE_DINGTALK_AUTH=true
CLOUDCLI_IDENTITY_REGISTRY_REQUIRED=1
CLOUDCLI_IDENTITY_STARTUP_APPROVED=0
CLOUDCLI_DINGTALK_CREDENTIALS_FILE=/run/secrets/cloudcli-dingtalk.json
CLOUDCLI_DINGTALK_PUBLIC_ORIGIN=https://qa-cloudcli.example.invalid
CLOUDCLI_IDENTITY_REGISTRY_PATH=/run/config/identities.json
CLOUDCLI_IDENTITY_RUNTIME_MAP_PATH=/run/secrets/identity-runtime-map.json

# Build flags shared with the developer/analysis frontend.
VITE_IS_PLATFORM=false
VITE_COMIC_RUNTIME_ONLY=true

# Use only the dedicated read-only provider state prepared by this deployment.
COMIC_CODEX_HOME=/srv/cloudcli/state/provider-ro/codex
COMIC_CLAUDE_CONFIG_DIR=/srv/cloudcli/state/provider-ro/claude
CLOUDCLI_READONLY_HOME=/srv/cloudcli/state/provider-ro
CLOUDCLI_READONLY_CODEX_HOME=/srv/cloudcli/state/provider-ro/codex
CLOUDCLI_READONLY_CLAUDE_CONFIG_DIR=/srv/cloudcli/state/provider-ro/claude
DATABASE_PATH=/srv/cloudcli/state/auth.db

# Enable only when this deployment uses CC Switch synchronization.
# COMIC_CC_SWITCH_SYNC=1
# A token helper remains disabled for read-only turns unless separately approved.
# See docs/deployment-readonly.md for the credential-helper boundary.
