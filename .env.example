# CloudCLI UI Environment Configuration
# Only includes variables that are actually used in the code
#
# TIP: Run 'cloudcli status' to see where this file should be located
#      and to view your current configuration.
#
# Available CLI commands:
#   claude-code-ui    - Start the server (default)
#   cloudcli start    - Start the server
#   cloudcli status   - Show configuration and data locations
#   cloudcli help     - Show help information
#   cloudcli version  - Show version information

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Backend server port (Express API + WebSocket server)
#API server
SERVER_PORT=3001
#Frontend port
VITE_PORT=5173

# Host/IP to bind servers to (default: 0.0.0.0 for all interfaces)
# Use 127.0.0.1 to restrict to localhost only
HOST=0.0.0.0

# =============================================================================
# DEPLOYMENT POLICY (choose one; keep secrets outside this file)
# =============================================================================

# For a shared release serving product/QA and developer/analysis deployments,
# see docs/deployment-profiles.md and examples/deployment/*.env.example.
# Optional new-conversation default for explicitly configured developer services.
# Read-only deployments ignore bypassPermissions and remain restricted.
# CLOUDCLI_DEFAULT_PERMISSION_MODE=default

# Local development keeps the full Git/Terminal/worktree capability set.
# Set this explicitly; otherwise the server falls back to self-hosted (or the
# legacy platform profile when VITE_IS_PLATFORM=true).
# CLOUDCLI_DEPLOYMENT_PROFILE=developer

# 0.78 product/operations/QA deployment: verified DingTalk project users can
# inspect code and use read-only chat, but cannot write files, run a shell, or
# mutate Git. Pending/ambiguous identities remain in the enrollment/read flow.
# CLOUDCLI_DEPLOYMENT_PROFILE=product-qa-readonly
# CLOUDCLI_REQUIRE_DINGTALK_AUTH=true
# CLOUDCLI_DINGTALK_CREDENTIALS_FILE=/run/secrets/cloudcli-dingtalk.json
# CLOUDCLI_DINGTALK_PUBLIC_ORIGIN=https://<actual-cloudcli-origin>
# CLOUDCLI_IDENTITY_REGISTRY_PATH=/run/config/identities.json
# CLOUDCLI_IDENTITY_REGISTRY_REQUIRED=1
# CLOUDCLI_IDENTITY_RUNTIME_MAP_PATH=/run/secrets/identity-runtime-map.json
# Provider state for product/QA turns must be an isolated, service-owned path;
# never inherit a developer's HOME, CODEX_HOME, or Claude config directory.
# The COMIC_* values are read by CloudCLI's history/auth synchronizers. The
# CLOUDCLI_READONLY_* values are mapped to HOME/CODEX_HOME/CLAUDE_CONFIG_DIR
# only inside readonly provider children.
# COMIC_CODEX_HOME=/srv/cloudcli/state/provider-ro/codex
# COMIC_CLAUDE_CONFIG_DIR=/srv/cloudcli/state/provider-ro/claude
# CLOUDCLI_READONLY_HOME=/srv/cloudcli/state/provider-ro
# CLOUDCLI_READONLY_CODEX_HOME=/srv/cloudcli/state/provider-ro/codex
# CLOUDCLI_READONLY_CLAUDE_CONFIG_DIR=/srv/cloudcli/state/provider-ro/claude
# CLOUDCLI_SETTINGS_ADMIN_USER_IDS=<verified-admin-user-id>

# Optional Dataverse credential-helper boundary (deployment-owned, never
# request-controlled). CloudCLI does not start DeepSeek Harness itself. If a
# deployment chooses to use a helper (including one backed by DSH), it is
# invoked just before a provider turn and its stdout is kept in memory.
# If the helper reads `$CODEX_HOME/auth.json`, set this to the operator-owned
# Codex home while the provider itself may use an isolated CODEX_HOME. When
# omitted, the server derives the home from the parent of
# COMIC_CC_SWITCH_CODEX_CONFIG_PATH when that path ends in `config.toml`.
# COMIC_DATAVERSE_TOKEN_HELPER=/srv/cloudcli/bin/dataverse-token-helper
# COMIC_DATAVERSE_TOKEN_HELPER_CODEX_HOME=/srv/cloudcli/credentials/codex
# For a helper that reads a protected account home, point only the helper at
# that source. This does not change HOME for Claude/Codex provider children;
# do not mount a personal `~/.config/deepseek-harness` into CloudCLI.
# COMIC_DATAVERSE_TOKEN_HELPER_HOME=/srv/cloudcli/credentials/account
# Read-only product/QA turns do not execute the helper by default. Set this
# only when the deployment has reviewed the helper and its credential source;
# it is a process-startup setting, never a browser/request option.
# CLOUDCLI_READONLY_ALLOW_DATAVERSE_HELPER=1

# Optional capability overrides are deployment-owned. Never use them to reopen
# a mutating capability in product-qa-readonly; the server forcibly denies it.
# CLOUDCLI_DEPLOYMENT_CAPABILITIES=attachment.upload=true,session.write=true

# Uncomment the following line if you have a custom claude cli path other than the default "claude"
# CLAUDE_CLI_PATH=claude

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Path to the authentication database file
# This is where user credentials, API keys, and tokens are stored.
#
# To use a custom location:
# DATABASE_PATH=/path/to/your/custom/auth.db

# For a read-only 0.78 host, keep this database and ~/.cloudcli/assets outside
# the read-only code mount (for example under /srv/cloudcli/state) and grant
# access only to the dedicated CloudCLI service account.
#
# Claude Code context window size (maximum tokens per session)
VITE_CONTEXT_WINDOW=160000
CONTEXT_WINDOW=160000
